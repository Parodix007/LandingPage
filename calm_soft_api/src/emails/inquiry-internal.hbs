<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>New project inquiry — calm_soft</title>
</head>
<body style="margin:0; padding:0; background-color:#000000;">
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{name}} · {{email}}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#000000;">
  <tr>
    <td align="center" style="padding:36px 12px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px;">

        <!-- Header: logo + pill -->
        <tr>
          <td style="padding:0 0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td style="font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:22px; font-weight:600; letter-spacing:-0.02em; color:#f5f5f7;">calm<span style="color:#7ce38b;">_</span>soft</td>
                <td align="right"><span style="display:inline-block; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; font-weight:500; padding:6px 13px; border-radius:980px; background-color:#1c241d; border:1px solid #3b4d3f; color:#f5f5f7;">Internal &middot; new inquiry</span></td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Title -->
        <tr>
          <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:22px; font-weight:700; letter-spacing:-0.02em; line-height:26px; color:#f5f5f7; padding-bottom:6px;">New project inquiry.</td>
        </tr>
        <tr>
          <td style="font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:12px; color:#7c7c7e; padding-bottom:18px;">{{submittedAt}} &middot; {{source}}</td>
        </tr>

        <!-- Contact card -->
        <tr>
          <td style="background-color:#101012; border:1px solid #232326; border-radius:20px; padding:22px 26px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr><td colspan="2" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:#7ce38b; font-weight:600; padding-bottom:10px;">Contact</td></tr>
              <tr>
                <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90;">Name</td>
                <td align="right" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#f5f5f7;">{{name}}</td>
              </tr>
              <tr>
                <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90; padding-top:9px;">Email</td>
                <td align="right" style="padding-top:9px;"><a href="mailto:{{email}}" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#7ce38b; text-decoration:none;">{{email}}</a></td>
              </tr>
            </table>
          </td>
        </tr>

        <tr><td style="height:14px; line-height:14px; font-size:0;">&nbsp;</td></tr>

        <!-- Message card -->
        <tr>
          <td style="background-color:#101012; border:1px solid #232326; border-radius:20px; padding:22px 26px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr><td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:#7ce38b; font-weight:600; padding-bottom:10px;">Project description</td></tr>
              <tr>
                <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:22px; color:#b0b0b2; border-left:2px solid #467a4e; padding-left:14px; white-space:pre-line;">{{message}}</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CTA -->
        <tr>
          <td style="padding-top:18px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td><a href="mailto:{{email}}" style="display:inline-block; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; padding:12px 28px; border-radius:980px; background-color:#7ce38b; color:#000000; font-weight:600; font-size:15px; text-decoration:none;">Reply to {{firstName}} &rsaquo;</a></td>
                <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#7c7c7e; padding-left:16px;">Reply-to is set to the sender &middot; 24h SLA</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding-top:28px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-top:1px solid #1a1a1c;">
              <tr>
                <td align="center" style="padding-top:22px; font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:14px; font-weight:600; letter-spacing:-0.02em; color:#b0b0b2;">calm<span style="color:#7ce38b;">_</span>soft</td>
              </tr>
              <tr>
                <td align="center" style="padding-top:10px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#5f5f61;">Internal notification &middot; calmsoft.com contact form &middot; &copy; {{year}}</td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
