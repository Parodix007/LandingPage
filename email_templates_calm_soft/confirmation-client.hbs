<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Request received — calm_soft</title>
</head>
<body style="margin:0; padding:0; background-color:#000000;">
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">We got your request — a senior engineer replies within 24 hours.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#000000;">
  <tr>
    <td align="center" style="padding:36px 12px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px;">

        <!-- Logo -->
        <tr>
          <td align="center" style="padding:0 0 24px; font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:22px; font-weight:600; letter-spacing:-0.02em; color:#f5f5f7;">calm<span style="color:#7ce38b;">_</span>soft</td>
        </tr>

        <!-- Card -->
        <tr>
          <td style="background-color:#101012; border:1px solid #232326; border-radius:20px; padding:34px 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td align="center" style="padding-bottom:18px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td align="center" width="56" height="56" style="width:56px; height:56px; border-radius:50%; background-color:#283e2d; border:1px solid #7ce38b; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:22px; line-height:56px; color:#7ce38b;">&#10003;</td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td align="center" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:24px; font-weight:700; letter-spacing:-0.02em; color:#f5f5f7; padding-bottom:12px;">Request received.</td>
              </tr>
              <tr>
                <td align="center" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; line-height:23px; color:#b0b0b2; padding-bottom:22px;">Thanks, {{firstName}} — your project inquiry just landed with our engineers. A senior engineer (not a sales script) will get back to you within 24 hours to schedule the first meeting.</td>
              </tr>
              <tr>
                <td style="background-color:#1a1a1c; border:1px solid #262629; border-radius:14px; padding:16px 20px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                    <tr>
                      <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90;">Service</td>
                      <td align="right" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#f5f5f7;">{{service}}</td>
                    </tr>
                    <tr>
                      <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90; padding-top:9px;">First meeting</td>
                      <td align="right" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#f5f5f7; padding-top:9px;">{{meeting}}</td>
                    </tr>
{{#if discoverWorkshop}}
                    <tr>
                      <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90; padding-top:9px;">Discover workshop</td>
                      <td align="right" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#7ce38b; padding-top:9px;">Included</td>
                    </tr>
{{/if}}
{{#if maintenanceHandover}}
                    <tr>
                      <td style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; color:#8e8e90; padding-top:9px;">Maintenance handover</td>
                      <td align="right" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#7ce38b; padding-top:9px;">Included</td>
                    </tr>
{{/if}}
                  </table>
                </td>
              </tr>
              <tr>
                <td align="center" style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#7c7c7e; padding-top:18px;">NDA on request — your idea stays yours.</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding-top:28px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-top:1px solid #1a1a1c;">
              <tr>
                <td align="center" style="padding-top:22px; font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:14px; font-weight:600; letter-spacing:-0.02em; color:#b0b0b2;">calm<span style="color:#7ce38b;">_</span>soft</td>
              </tr>
              <tr>
                <td align="center" style="padding-top:10px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#8e8e90;"><a href="https://calmsoft.com/#services" style="color:#7ce38b; text-decoration:none;">Services</a> &middot; <a href="https://calmsoft.com/#process" style="color:#7ce38b; text-decoration:none;">Process</a> &middot; <a href="https://calmsoft.com/#cases" style="color:#7ce38b; text-decoration:none;">Case studies</a></td>
              </tr>
              <tr>
                <td align="center" style="padding-top:10px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#7c7c7e;">calm_soft &middot; Wroc&#322;aw, Poland &middot; <a href="mailto:hello@calmsoft.com" style="color:#7ce38b; text-decoration:none;">hello@calmsoft.com</a></td>
              </tr>
              <tr>
                <td align="center" style="padding-top:10px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; color:#5f5f61;">You're receiving this email because you contacted calmsoft.com &middot; &copy; {{year}}</td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
