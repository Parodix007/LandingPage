# Origin API backendu — SAM origin, bez ścieżki/trailing-slash/query, np.
# https://api.calmsoft.pro (nie https://api.calmsoft.pro/inquiries, nie z '/' na końcu).
# Wymagany w prod, chyba że jawny mock:
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Jawny mock: 1 = sukces, fail = symulacja błędu. Nigdy nie jest domyślny.
NEXT_PUBLIC_INQUIRY_MOCK=

# Origin produkcyjny (canonical/OG) — wymagany dla buildów z API base URL:
NEXT_PUBLIC_SITE_URL=https://example.com

# Publiczny adres e-mail kontaktowy pokazywany w sekcji Contact (mailto + tekst).
# Opcjonalny — bez niego używany jest domyślny hello@calmsoft.com (fallback w src/content/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=hello@calmsoft.com

# Publiczny site key Cloudflare Turnstile — to nie sekret, bezpiecznie osadzić w bundlu.
# Wymagany dla buildów z API base URL (bez niego widget się nie wyrenderuje → 403 na submicie).
# Klucze testowe Cloudflare (działają też na localhost, do dev/CI):
#   invisible, always-pass:  1x00000000000000000000BB
#   invisible, always-fail:  2x00000000000000000000BB
# Klucz produkcyjny JEST publiczny, ale musi zastąpić klucz testowy i być zarejestrowany dla
# domeny w panelu Turnstile — inaczej server-side siteverify po stronie API zawsze odrzuci.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analityka cookieless (skrypt renderowany tylko gdy oba ustawione):
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
