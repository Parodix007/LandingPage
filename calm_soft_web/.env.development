# Ten plik jest gitignorowany (wzorzec `.env*` w .gitignore) — miejsce na lokalne
# sekrety/nadpisania, w tym prawdziwy Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADyHDjAP-riXdsY9
# paste your PRODUCTION Turnstile site key here for local prod-like testing

# Aby przetestować lokalnie PRAWDZIWY 3-krokowy flow (Turnstile execute -> GET formToken ->
# POST /api/contact) zamiast mocka: ustaw origin API poniżej, zostaw klucz Turnstile powyżej
# (testowy lub prawdziwy) i zostaw NEXT_PUBLIC_INQUIRY_MOCK PUSTE (mock ma pierwszeństwo, gdy
# oba są ustawione — patrz warn w scripts/assert-env.mjs).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4200
# NEXT_PUBLIC_INQUIRY_MOCK=
NEXT_PUBLIC_CONTACT_EMAIL=team@calmsoft.pro

